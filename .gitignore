# dependencies
node_modules/

# runtime data: sqlite db, WhatsApp auth credentials, media cache, warmup state
data/
logs/

# secrets — never commit. .env.* also covers .env.bak.*, .env.local, etc.
.env
.env.*
!.env.example

# holds each install's addresses; deploy/asterisk/etc/pjsip.conf.example is the template
deploy/asterisk/etc/pjsip.conf

# personal persona — each install owns its own (generated by `npm run setup`).
# Committed references live alongside as *.example.* / *.template.*
src/personality/identity.md
src/personality/*.bak.*
src/personality/persona.json
src/personality/taste.json
src/personality/world.json
src/personality/arcs.json
src/personality/phrases.json*
