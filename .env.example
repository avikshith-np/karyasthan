# =============================================================================
# Easiest setup: run `npm run setup` — it creates this .env interactively,
# generates your bot's persona, runs migrations, and offers WhatsApp pairing.
# Or copy this file to .env and fill it in by hand.
#
# The persona (name, personality, language) is NOT configured here — it lives in
# src/personality/persona.json + identity.md, generated by `npm run setup`.
# =============================================================================

# LLM — provider keys. Each provider uses ONLY its own key; none falls back to another's.
LLM_API_KEY=                    # OpenAI key only (no other provider uses it)
ANTHROPIC_API_KEY=              # Anthropic (Claude) API key — only needed if a role uses provider=anthropic
OPENROUTER_API_KEY=             # OpenRouter API key (also Jev's key unless JEV_API_KEY is set)
GLM_API_KEY=                    # Zhipu AI GLM API key (only needed if a role uses provider=glm)
XAI_API_KEY=                    # xAI (Grok) API key from console.x.ai (only needed if a role uses provider=xai)
GEMINI_API_KEY=                 # Google Gemini API key (gemini roles, transcription, image, voice, bills)
LLM_BASE_URL=                   # Endpoint for the 'local' provider (set a role's provider to local to use it):
                                # a local OpenAI-compatible server, e.g. http://127.0.0.1:18080/v1/chat/completions
LLM_LOCAL_API_KEY=              # optional Bearer token for the 'local' provider only (never falls back to LLM_API_KEY)
LLM_MONTHLY_BUDGET_USD=30       # global monthly cap across every role and metered label (chat replies are never blocked)
LLM_TEMPERATURE=0.7             # LLM temperature (lower = more coherent; Opus 5.5 ignores it)
TRANSCRIPTION_MODEL=gemini-3-flash-preview  # voice-note transcription + image/sticker description. A bare Google id
                                # goes to native Gemini (GEMINI_API_KEY); a vendor/model id (google/…) to OpenRouter

# Model roles: provider/model/effort/fallback/timeout/budget per kind of work.
# Generated from src/brain/roles.js — edit the registry, then `npm run gen:env -- --write`.
# >>> roles (generated: npm run gen:env) >>>
# One block per model role (spec 007). Every field is optional; the value shown is the
# code default. A role with `inherit` takes the parent role's value for each EMPTY field.
# Each provider uses ONLY its own key (ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY,
# GLM_API_KEY, XAI_API_KEY; LLM_API_KEY is the OpenAI key). Budgets sit under the global LLM_MONTHLY_BUDGET_USD.
# A Grok model id depends on the route: x-ai/grok-4.7 with provider=openrouter, grok-4.7 with
# provider=xai (key from console.x.ai). Change the provider and the model together.

# mouth — chat replies: group/DM replies, web-search loop, Instagram chat replies and captions
LLM_PROVIDER=gemini                      # anthropic | openai | gemini | glm | openrouter | xai | ollama | local
LLM_MODEL=gemini-3.8-flash
LLM_EFFORT=low                           # low | medium | high | xhigh | max (empty = send none)
LLM_MAX_TOKENS=3072
LLM_FALLBACK_PROVIDER=ollama             # other roles: empty = this fallback; 'none' = no fallback
LLM_FALLBACK_MODEL=gemini-3-flash-preview
LLM_TIMEOUT_MS=0                         # ms per chain link (retries included), 0 = none
LLM_BUDGET_USD=0                         # USD per calendar month in TIMEZONE; 0 = none

# clerk — background text work: batch learning, call summaries, voice descriptors, GIF queries, taste card (empty fields inherit mouth)
LLM_CLERK_PROVIDER=
LLM_CLERK_MODEL=
LLM_CLERK_EFFORT=
LLM_CLERK_MAX_TOKENS=
LLM_CLERK_FALLBACK_PROVIDER=
LLM_CLERK_FALLBACK_MODEL=
LLM_CLERK_TIMEOUT_MS=
LLM_CLERK_BUDGET_USD=0

# mind — deliberate reasoning: the mind (mind.*), life world seed, Director prompt, story passes, dashboard probe
LLM_MIND_PROVIDER=anthropic
LLM_MIND_MODEL=claude-opus-5-5
LLM_MIND_EFFORT=medium
LLM_MIND_MAX_TOKENS=16000
LLM_MIND_FALLBACK_PROVIDER=
LLM_MIND_FALLBACK_MODEL=
LLM_MIND_TIMEOUT_MS=120000
LLM_MIND_BUDGET_USD=10

# fun — shadow-only experiments (never sends to a chat), e.g. the proactive A/B
LLM_FUN_PROVIDER=openrouter
LLM_FUN_MODEL=x-ai/grok-4.7
LLM_FUN_EFFORT=
LLM_FUN_MAX_TOKENS=1024
LLM_FUN_FALLBACK_PROVIDER=none
LLM_FUN_FALLBACK_MODEL=
LLM_FUN_TIMEOUT_MS=30000
LLM_FUN_BUDGET_USD=2

# desire — explicit in-world texts and private scenes (never a chat send; no fallback)
LLM_DESIRE_PROVIDER=openrouter
LLM_DESIRE_MODEL=x-ai/grok-4.7
LLM_DESIRE_EFFORT=
LLM_DESIRE_MAX_TOKENS=1024
LLM_DESIRE_FALLBACK_PROVIDER=none
LLM_DESIRE_FALLBACK_MODEL=
LLM_DESIRE_TIMEOUT_MS=60000
LLM_DESIRE_BUDGET_USD=5

# gate — quality gate judge (fails open for plain text, closed for cloned voice)
QUALITY_GATE_PROVIDER=gemini
QUALITY_GATE_MODEL=gemini-3.8-flash
QUALITY_GATE_EFFORT=low
QUALITY_GATE_MAX_TOKENS=256
QUALITY_GATE_FALLBACK_PROVIDER=
QUALITY_GATE_FALLBACK_MODEL=
QUALITY_GATE_TIMEOUT_MS=8000
QUALITY_GATE_BUDGET_USD=0

# jev — TypeSafe System One typed decisions via OpenRouter (Instagram judge + chat choice, relay intent, pre-filter, life decisions + claims, mind glances, chat perception)
JEV_MODEL=typesafe/jev-1.14
JEV_TIMEOUT_MS=30000                     # ms per Jev call
JEV_BUDGET_USD=0

# Metered labels (budget only; their models are set elsewhere: TRANSCRIPTION_MODEL,
# IG_DESCRIBE_MODEL, IMAGE_GEN_MODEL, VOICE_NOTE_MODEL, BILL_SPLIT_MODEL).
LLM_SENSES_BUDGET_USD=0                  # transcription, media description, reel description (never blocked: chat input)
LLM_IMAGE_BUDGET_USD=0                   # image generation and editing
LLM_VOICE_BUDGET_USD=0                   # voice-note TTS
LLM_BILL_BUDGET_USD=0                    # receipt and assignment parsing
LLM_PROBE_BUDGET_USD=0                   # dashboard TEST button
# <<< roles <<<

# Jev "would he reply?" pre-filter (group turns). On/off is the "jev-prefilter" skill;
# JEV_PREFILTER_ENABLED is only its boot default. shadow = only log Jev's guess next
# to what the chat model did; enforce = skip generation below the threshold.
JEV_PREFILTER_ENABLED=true
JEV_PREFILTER_MODE=shadow       # shadow | enforce
JEV_PREFILTER_SKIP_BELOW=0.25   # enforce: skip when Jev's reply probability is below this

# WhatsApp phone number (digits only, with country code, e.g. 15550100123)
WA_PHONE_NUMBER=

# Behavior
RESPONSE_RATE=0.15
SLEEP_START_HOUR=0
SLEEP_END_HOUR=7
TIMEZONE=UTC

# Rate Limits
MAX_PER_GROUP_HOUR=8
MAX_GLOBAL_HOUR=20
# When a cap blocked a reply he'd have sent, send ONE catch-up reply in that group
# once the cap frees (in-memory; dropped after CAP_CATCHUP_MAX_AGE_MINUTES)
CAP_CATCHUP_ENABLED=true
CAP_CATCHUP_MAX_AGE_MINUTES=120

# Paths
DB_PATH=./data/karyasthan.db
AUTH_PATH=./data/auth_info_baileys
LOG_LEVEL=info

# Warm-up
WARMUP_ENABLED=true

# Dry run (logs responses instead of sending)
DRY_RUN=false

# Bill Split (uses Gemini Pro for receipt OCR — only for bill splitting)
BILL_SPLIT_MODEL=gemini-2.5-pro

# Image Generation (uses GEMINI_API_KEY)
IMAGE_GEN_ENABLED=true
IMAGE_GEN_MODEL=imagen-4.0-generate-001
# Model used when editing a replied-to image (image-in → image-out)
IMAGE_EDIT_MODEL=gemini-3-pro-image-preview
IMAGE_GEN_MAX_PER_HOUR=5

# Voice Notes (uses GEMINI_API_KEY for Gemini TTS)
VOICE_NOTE_ENABLED=true
VOICE_NOTE_MODEL=gemini-3.8-flash-tts
# Prebuilt name (Puck, Kore, …) or a custom voice id (voice_…) from Voice Design —
# a designed voice in your own language/accent sounds far less "narrator".
VOICE_NOTE_VOICE=Puck
VOICE_NOTE_FALLBACK_MODEL=gemini-3.1-flash-tts-preview
VOICE_NOTE_FALLBACK_VOICE=Puck
VOICE_NOTE_MAX_PER_HOUR=10
VOICE_CLONE_MODEL=gemini-3.8-flash-tts   # TTS model for cloned (imitate-voice) notes — must support Voice Replication

# Quality Gate (uses cheap Gemini Flash to check response quality before sending).
# The gate FAILS OPEN: if the judge LLM errors/times out/returns junk, the reply is
# sent unevaluated (logged at warn with evt:issue so bypasses are visible). Its
# routing is the `gate` role above (QUALITY_GATE_PROVIDER/_MODEL/_MAX_TOKENS/_TIMEOUT_MS;
# max tokens below 256 are raised to 256 so thinking models don't return empty; the
# timeout bounds each chain link). With no QUALITY_GATE_FALLBACK_* it falls back to
# mouth's fallback (LLM_FALLBACK_*).
QUALITY_GATE_ENABLED=true
QUALITY_GATE_THRESHOLD=0.4           # 0.0-1.0, below this = blocked
QUALITY_GATE_MENTION_THRESHOLD=0.25  # Lower threshold for @mentions
QUALITY_GATE_TEMPERATURE=0.1         # judge temperature (keep low for consistent scores)

# Stickers + GIFs (key from https://developers.giphy.com/dashboard)
GIPHY_API_KEY=
STICKER_MAX_PER_HOUR=8
GIF_MAX_PER_HOUR=8

# Web search + browsing
#   search → self-hosted SearXNG (no API key). Its settings.yml MUST enable JSON:
#            search:
#              formats: [html, json]
#   browse → Playwright headless Chromium. After `npm install`, run once:
#              npx playwright install chromium
#            (~300MB. If absent, browsing is disabled but search still works.)
# The master on/off is the "web-search" skill in the dashboard Skills tab;
# WEB_SEARCH_ENABLED below is only its BOOT default. Web lookups also run under
# DRY_RUN (they're read-only, not a send).
WEB_SEARCH_ENABLED=true
SEARXNG_URL=http://127.0.0.1:8888
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_MAX_HOPS=1            # 1 = search-and-answer / browse-a-URL. 2 chains search→browse but also needs IN_FLIGHT_SAFETY_MS raised (events.js)
WEB_SEARCH_TIMEOUT_MS=5000
WEB_SEARCH_BUDGET_MS=20000      # wall-clock cap on all web ops per reply
WEB_SEARCH_MAX_PER_HOUR=30
WEB_BROWSE_ENABLED=true
WEB_BROWSE_MAX_PER_HOUR=15
WEB_BROWSE_TIMEOUT_MS=8000
WEB_BROWSE_MAX_CHARS=4000
WEB_BROWSE_CONCURRENCY=2
WEB_BROWSE_IDLE_MS=300000       # close the idle browser after this to free RAM
WEB_BROWSE_ALLOW_PRIVATE=false  # SSRF escape hatch — KEEP false. true lets the bot fetch private/loopback/metadata IPs

# Imitate mode — the bot impersonates a chosen group member's chat style using
# their real message history. The master on/off is the "imitate" skill in the
# dashboard Skills tab; IMITATE_MODE_ENABLED below is only its BOOT default.
# Per-group targets are set on each group's dashboard page (needs
# DASHBOARD_READONLY=false) and ALWAYS auto-expire.
IMITATE_MODE_ENABLED=false
IMITATE_MAX_MINUTES=360     # hard ceiling on one activation (auto-expiry is mandatory)
IMITATE_MIN_MESSAGES=40     # refuse to imitate anyone with less history than this
IMITATE_ANNOUNCE=false      # true = post a one-time in-chat notice when a target is set
# Imitate VOICE: voice notes in the target's own cloned voice. The person must enroll
# themselves (DM the bot "voice enroll", or dashboard upload) incl. a consent recording.
IMITATE_VOICE_ENABLED=false         # boot default of the "imitate-voice" skill
IMITATE_VOICE_MAX_PER_SESSION=3     # cloned voice notes per imitation activation (0 = no cap; hourly VOICE_NOTE_MAX_PER_HOUR still applies)

# Instagram reels (specs/005) — the real Instagram app on a dedicated Android phone,
# driven over ADB. The driver may control ONLY com.instagram.android (fixed operations,
# foreground check before every input). The master on/off for AUTOMATIC sessions is the
# "instagram-reels" skill; IG_ENABLED is only its boot default. The dashboard's
# #instagram page has a manual Browse button and the share queue.
IG_ENABLED=false
IG_DEVICE_SERIAL=               # the phone's hardware serial (adb shell getprop ro.serialno)
IG_DEVICE_MODEL=                # model as `adb devices -l` lists it, e.g. PM2000
IG_GROUP_NAME=                  # exact title of the Instagram group to share into (plain ASCII)
IG_LAUNCHER_PACKAGES=com.android.launcher   # home-screen app(s) a session may launch Instagram over
IG_ADB_PATH=~/.local/opt/platform-tools/adb
IG_SCRCPY_PATH=~/.local/opt/scrcpy/scrcpy   # scrcpy ≥ 2 records clips WITH audio (run as --no-control)
JEV_API_KEY=                    # optional; defaults to the current OpenRouter key (incl. one set on the dashboard). Jev's model (JEV_MODEL) is the `jev` role above
IG_DESCRIBE_MODEL=gemini-3.8-flash   # watches clips/frames (needs GEMINI_API_KEY)
IG_SESSIONS_PER_DAY=4
IG_SESSION_MIN_MINUTES=5
IG_SESSION_MAX_MINUTES=12
IG_LIKES_PER_DAY=25
IG_SHARES_PER_DAY=3
IG_APPROVAL_MODE=approve-each   # approve-each = nothing is sent without a dashboard tap; auto = best reels go out
IG_WARMUP_DAYS=10               # no automatic shares until the account has browsed this many days
IG_WATCH_MODE=live              # live = Gemini Live watches the screen+audio stream and decides after ~3 s; clip = record a clip per promising reel
IG_LIVE_MODEL=gemini-3.8-live
IG_FIRST_LOOK_SECONDS=3         # live: first report this long after a reel lands (then Jev: swipe or keep watching)
IG_FULL_LOOK_SECONDS=12         # live: full report for reels worth watching
IG_CLIP_SECONDS=15              # clip mode / fallback
IG_FRAMES_TO_JEV=false          # also send 3 frames to Jev (its image input is experimental)
IG_CHAT_ENABLED=false           # boot default of the "instagram-chat" skill: read the group thread and reply/heart on his own
IG_CHAT_POLL_MINUTES=20         # how often he checks the group while awake (also after each browsing session)
IG_CHAT_MAX_REPLIES_PER_HOUR=6
# Instagram judge thresholds (src/instagram/judge.js). Jev scores humour and fit on a
# 0–3 scale; hazards and confidence are probabilities (0–1). The action is decided in
# code and fails closed: any hazard at/above the threshold, an ad, or low confidence → no like.
IG_HAZARD_THRESHOLD=0.25        # a hazard (politics, religion, NSFW, violence, scam, cruelty, tragedy) at/above this blocks the reel
IG_MIN_CONFIDENCE=0.4           # below this Jev confidence (min of humour/fit), do nothing
IG_LIKE_HUMOUR=1.8              # like if humour ≥ this …
IG_LIKE_FIT=1.5                 # … or fit ≥ this
IG_QUEUE_HUMOUR=2.2             # like AND save to the share queue if humour ≥ this …
IG_QUEUE_FIT=1.8                # … and fit ≥ this

# Phone calls (deploy/asterisk/; copy etc/pjsip.conf.example to etc/pjsip.conf and fill in your addresses) — cellular calls on the gateway phone's SIM reach
# Asterisk through an Android cellular<->SIP gateway; Asterisk hands each call to the
# ARI app, which bridges the audio to Gemini Live. The master on/off is
# the "calls" skill; CALLS_ENABLED is only its boot default. Keep ARI on localhost.
CALLS_ENABLED=false
ARI_URL=http://127.0.0.1:8088   # Asterisk REST interface (localhost only)
ARI_USER=karyasthan
ARI_PASSWORD=                   # ARI password (must match deploy/asterisk ari.conf)
ARI_APP=karyasthan              # Stasis app name the dialplan hands calls to
CALL_GATEWAY_ENDPOINT=android-gw   # PJSIP endpoint of the gateway phone (dial string PJSIP/<number>@<endpoint>)
CALL_LIVE_MODEL=gemini-3.8-live
CALL_VOICE=                     # Gemini Live prebuilt voice; empty = VOICE_NOTE_VOICE if that's a prebuilt name, else Enceladus (Live ignores voice_… ids)
CALL_LANGUAGE_CODES=en-US        # expected spoken languages (BCP-47, comma-separated): pins Live's speech recognition
CALL_MAX_MINUTES=14             # hard cap per call (Gemini Live caps sessions at 15 min)
CALL_RING_TIMEOUT_SEC=45
CALL_ALLOWED_NUMBER_RE=          # outbound-dial allow-list (E.164 regex), a security knob. Empty dials nothing. Example: ^\+1\d{10}$
CALL_DEFAULT_COUNTRY_CODE=       # country code for a caller's number that arrives without one (digits, e.g. 1). Empty: not guessed, an unknown caller
CALL_RTP_HOST=127.0.0.1         # local address Asterisk sends call RTP to (externalMedia)
CALL_DEBUG_AUDIO=false          # true = save each call's audio under data/calls-debug/ (sensitive — troubleshooting only)

# Life simulation (specs/009) — he lives a simulated day on the real clock (routine,
# commute, meals, sleep, moods, small decisions) and answers when he'd actually be on
# his phone: busy/asleep → messages wait for his next phone check. The master on/off
# is the "life" skill in the dashboard Skills tab; LIFE_ENABLED below is only its
# BOOT default. The world (places, cast, routine, climate) lives in the gitignored
# src/personality/world.json, generated once per install by ONE call to the mind role
# (LLM_MIND_*). The example world is never used live: if the seed fails, life stays
# off (messages flow as with LIFE_ENABLED=false) and the seed is retried later.
LIFE_ENABLED=false
LIFE_TICK_MINUTES=15            # pulse interval (code only, no LLM per tick)
LIFE_CATCHUP_HOURS=72           # replay up to this much downtime; longer → re-anchor at "now"
LIFE_JEV_MAX_PER_DAY=40         # Jev calls/day for timed decisions (beyond it → code fallback)
LIFE_COMMIT_P=0.8               # commit a decision early once its lean reaches this probability
LIFE_PHRASE_BANKS=false         # thoughts, live lines, dream fragments in his voice, from src/personality/phrases.json (scripts/gen-phrases.js); off = today's English
LIFE_QUEUE_MAX_AGE_HOURS=18     # deferred messages older than this are read, not answered
LIFE_CLAIMS_MAX_PER_HOUR=10     # cap on self-claims in sent replies flagged for review per hour
LIFE_SELF_MENTION_BUDGET=3      # replies/chat/24 h that may mention his own life before it goes tone-only
LIFE_EMBARGO_HOURS=12           # quiet period after a heavy life event
LIFE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png   # dashboard Map tiles (loaded by the browser); empty = blank grid, no tiles

# Real places (specs/014) — OpenStreetMap lookups for the Director's PLACES panel
# (search a venue, "make places real", refresh road routes). Owner clicks only;
# never from a chat or a model. Every key here is .env-only (an SSRF surface:
# none is dashboard-mutable). Hand-written block (gen:env covers only the roles).
# Policies: https://operations.osmfoundation.org/policies/nominatim/ (≤ 1 req/s,
# an identifying User-Agent with a contact, cache results, no autocomplete) and
# the Overpass usage policy. Results are © OpenStreetMap contributors (ODbL).
GEO_ENABLED=true                 # false = no lookups at all (the panel says so)
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_OVERPASS_URL=https://overpass-api.de/api/interpreter
GEO_CONTACT_EMAIL=               # REQUIRED for Nominatim/Overpass (sent as email= and in the User-Agent; never logged)
# GEO_USER_AGENT=                # default: karyasthan-life-sim/<version> (+<contact>)
# Road routes (OSRM) are OFF until you set a host. The public demo
# (https://router.project-osrm.org) is "not for production" — self-host OSRM
# (docker) for real use. Route requests send the two endpoints' coordinates
# (home-kind endpoints rounded to ~100 m).
GEO_OSRM_URL=
GEO_OSRM_FOOT_URL=               # optional foot profile; empty = walks use the car route's distance
GEO_ALLOW_HTTP=false             # true allows http:// for a LAN / Tailscale / docker host (https otherwise; http always ok on loopback)
GEO_TIMEOUT_MS=8000              # per request (Overpass: at least 20000)
GEO_MAX_PER_DAY=400              # requests per day across the hosts, retries included (in-memory)
GEO_SWITCH_RADIUS_KM=2           # "make places real" search radius (0.2–5)

# Mind (specs/008) — a slow loop over the chats: glances (Jev), a few deliberate
# thinks (the `mind` role), one sleep per night (per-chat episodes, an optional
# self-model proposal), bounded lever nudges and proactive openers (shadow by default).
# The master on/off is the "mind" skill in the dashboard Skills tab; MIND_ENABLED is
# only its BOOT default. Pause, proactive mode (off|shadow|live), review mode, bands
# and exclusions are owner settings on the dashboard Mind page, never here.
# Pin the mind's fallback in the roles block above (LLM_MIND_FALLBACK_PROVIDER /
# LLM_MIND_FALLBACK_MODEL, or `none`): left empty it inherits the mouth's fallback, and
# a later mouth-fallback change would silently re-route mind traffic (research R4).
MIND_ENABLED=false
MIND_GLANCE_MINUTES=45                # minutes between glances while awake (15–180)
MIND_GLANCE_MAX_PER_DAY=20            # 0–40
MIND_THINK_MAX_PER_DAY=4              # 0–8
MIND_THINK_MIN_GAP_MINUTES=90         # 30–720
MIND_THINK_EFFORT=                    # empty = the mind role's effort; or low|medium|high (think only)
MIND_SLEEP_EFFORT=                    # empty = the mind role's effort; or low|medium|high (sleep only)
MIND_SELF_MODEL_EVERY_NIGHTS=3        # content-free self-model proposal every N nights (1–14)
MIND_CLERK_MAX_PER_DAY=60             # mind-caused clerk calls per day (digests, episodes, weekly; 0–120)
MIND_SLEEP_RESERVE_PCT=20             # share of the mind budget kept for sleep (0–50)
MIND_DIGEST_MAX_CHATS=8               # chats per think bundle (1–12)
MIND_DIGEST_MAX_LINES=120             # lines per chat digest (.env only)
MIND_SELF_MODEL_MAX_CHARS=1500        # hard cap (.env only)
MIND_SELF_STATE_MAX_CHARS=160         # hard cap of the self-state line (.env only)
MIND_INTENTION_TTL_HOURS=24           # .env only
MIND_REVIEW_DAYS=14                   # review window, applied once when first enabled live (.env only)
MIND_PROACTIVE_MODE=shadow            # first-boot seed only: off|shadow (live is set on the Mind page)
MIND_PROACTIVE_DM_EVERY_DAYS=3        # at most one opener per DM every N days (0 = no DM openers)
MIND_PROACTIVE_GROUP_PER_DAY=1        # openers per group per day (0 = no group openers)
MIND_PROACTIVE_MAX_PER_DAY=4          # openers per day in all
MIND_PROACTIVE_DM_BACKOFF_DAYS=7      # an ignored DM opener pauses that DM this long
MIND_PROACTIVE_GROUP_BACKOFF_DAYS=3   # an ignored group opener pauses that group this long
MIND_PROACTIVE_DRAFTS_PER_DAY=8       # drafts per day (shadow included; cost cap, 0–12)
MIND_PROACTIVE_MIN_SCORE=0.5          # quality-gate minimum for an opener (0.3–0.9)
MIND_PROACTIVE_TTL_HOURS=6            # a queued opener expires after this (.env only)
MIND_FUN_AB=false                     # shadow-only A/B voicing by the `fun` role, group targets only (sends the group's recent messages to that provider)
# Owner identities (phone numbers or JIDs, comma-separated; .env only). Never a
# proactive target; live proactive mode is refused while this is empty.
OWNER_JIDS=

# Relationships, arcs & Director (specs/010) — a story layer over the life
# simulation: cast lives and relationships, slow arcs (romance, career, family, rare
# heavy stretches with a veto card), a reconciler that adopts what he said in chats
# into his world, Ask-me cards, a private journal and the dashboard Director. Needs
# the "life" skill on. The master on/off is the "arcs" skill in the dashboard Skills
# tab; ARCS_ENABLED is only its BOOT default. Fate modes, sliders, pins, pause and
# the owner's reconciler mode are Director-page world events, never here. Arc content
# comes from the per-install src/personality/arcs.json (generated once; the committed
# arcs.example.json is the neutral fallback).
ARCS_ENABLED=false
ARCS_RECONCILER_MODE=auto             # boot default only: auto|review|off (the Director page switches it)
ARCS_EXTRACT_MAX_PER_HOUR=10          # claim extractions per hour (0–20)
ARCS_EXTRACT_MAX_PER_DAY=60           # claim extractions per day (0–120)
ARCS_TRAY_HOURS=72                    # an unreviewed claim expires after this (12–168)
ARCS_CLERK_MAX_PER_DAY=80             # background arcs clerk calls/day: extraction + journal (0–200)
ARCS_JEV_MAX_PER_DAY=20               # Jev leans on arc decisions, separate from LIFE_JEV_MAX_PER_DAY (0–40)
ARCS_MIND_BUDGET_USD=1                # month-to-date cap over the life.arcs.* callers (weekly pass, seed; 0–3); the Director prompt and the continuity story read also stop when life.arcs.* + director.prompt + director.continuity reach it
ARCS_PROMPT_MAX_PER_DAY=20            # Director prompt (TELL THE STORY) calls per local day (0–60; 0 = off)
ARCS_PROMPT_BUDGET_USD=0.5            # month-to-date cap over director.prompt calls alone (0–3)
ARCS_CONTINUITY_MAX_PER_DAY=30        # Director continuity story reads (one mind call per preview) per local day (0–100; 0 = off, the code checks still run)
ARCS_CONTINUITY_BUDGET_USD=0.5        # month-to-date cap over director.continuity calls alone (0–3)
ARCS_SCENES_ENABLED=true              # spec 016: play out how each outing with someone went (the arcs skill stays the master switch)
ARCS_SCENE_MAX_PER_DAY=8              # scene model calls of both tiers per local day (0–30; 0 = code one-liners only)
ARCS_SCENE_MIND_MAX_PER_DAY=3         # of those, mind-tier scenes (first meetings, dates, family occasions, owner-directed) (0–10)
ARCS_SCENE_CHAT_MAX_PER_DAY=2         # of those, scenes of outings a chat planned (narration only, always the clerk) (0–10)
ARCS_SCENE_BUDGET_USD=1               # month-to-date cap over the life.scene.* calls (0–5; the mind tier stops at 60 %; separate from ARCS_MIND_BUDGET_USD)
ARCS_SCENE_REGEN_MAX_PER_DAY=6        # owner REGENERATEs per local day (0–20; they also count in the day cap)
ARCS_SCENE_PUBLIC=true                # scenes in the public site export (fictional cast only)
ARCS_PHONE_ENABLED=true               # spec 019: he texts the fictional people in his world, they text back (the arcs skill stays the master switch)
ARCS_PHONE_MAX_PER_DAY=100000         # text turns (model calls of every writer) per local day (0–100000; default no practical limit; 0 = no texts)
ARCS_PHONE_PER_CAST_DAY=100000        # text turns with one member per local day (0–100000; default no practical limit)
ARCS_PHONE_ORGANIC_PER_DAY=100000     # conversations started on his own or by them per local day (0–100000; default no practical limit; owner-told texts and replies aside)
ARCS_PHONE_BUDGET_USD=3               # month-to-date cap over the life.phone.* calls (0–10; separate from the arcs and scene budgets)
# Dreams (plan 020 G): code but for a vivid dream's one small call a night (caller life.dream), under its own month-to-date cap.
ARCS_STANDING_ENABLED=true
ARCS_STANDING_MAX_PER_NIGHT=4
ARCS_STANDING_BUDGET_USD=0.3
ARCS_DREAMS_ENABLED=true
ARCS_DREAM_BUDGET_USD=0.3
# The claim check (plan 020 E3): each scene, text and journal part checked against its own fact sheet. Shadow: stores verdicts, changes nothing.
ARCS_CLAIM_CHECK_ENABLED=true
ARCS_CLAIM_CHECK_ENFORCE=false        # a contradiction → one rewrite, then the writer's fallback. Leave off until the Claim check page says it reads his speech right
ARCS_CLAIM_CHECK_MAX_PER_DAY=150      # clerk calls a day (0 = code checks only)
ARCS_CLAIM_CHECK_BUDGET_USD=0.5       # month-to-date cap over life.check.claims (0–3)
# Real thoughts (plan 020 F3): 3-6 a day at salient moments, one small mouth call each (caller life.thought.real). What he told himself vs what drove it. Dashboard only.
ARCS_REAL_THOUGHTS_ENABLED=false
ARCS_REAL_THOUGHT_MAX_PER_DAY=8       # model calls per local day (0-12; 0 = off)
ARCS_REAL_THOUGHT_BUDGET_USD=1        # month-to-date cap over life.thought.* (0-3; 0 = off)
ARCS_WEEKLY_EFFORT=low                # weekly arc pass effort: low|medium|high, or empty = the mind role's effort
ARCS_BIG_LEAD_HOURS=24                # a big decision opens at least this long before it is decided (24–168)
ARCS_REWIND_DAYS=14                   # how far back the Director can rewind (1–30)
ARCS_JOURNAL_ENABLED=true             # the nightly private journal (within the skill)
ARCS_NARRATE_MAX_PER_HOUR=20          # dashboard narrations per hour (0–40)
ARCS_NARRATE_MAX_PER_DAY=100          # dashboard narrations per day (0–200)
ARCS_BOOKMARKS_MAX=30                 # hard cap (.env only, 1–30)
ARCS_HEAVY_MIN_GAP_DAYS=90            # minimum gap between heavy stretches (.env only; can only be raised, < 90 → 90)
ARCS_CAST_MAX=24                      # hard cap on cast members (.env only, 0–24)
ARCS_NEW_CAST_PER_90D=2               # new cast members per 90 days (.env only, 0–2)
ARCS_BEATS_PER_WEEK=8                 # cast beats per weekly pass (.env only, 0–8)
ARCS_JOURNAL_MAX_CHARS=1200           # journal characters per night (.env only, 200–1200)
ARCS_JOURNAL_MAX_CALLS=6              # journal model calls per night (.env only, 0–6)
ARCS_SCENE_MAX_CHARS=1200             # a scene's narration cap (.env only, 400–1200, lower only)
ARCS_SCENE_MAX_AGE_HOURS=36           # an outing that ended longer ago than this when its job runs gets no scene (.env only, 6–72)

# Chats shape his life (specs/012) — what people say to him can nudge his mood a
# little (gone in ~1–2 h), keep him up past bedtime in a live chat (≤ 2 h) and add
# work pressure when he chats through a work hour. Needs the "life" skill on. The
# master on/off is the "chat-influence" skill in the dashboard Skills tab;
# CHAT_INFLUENCE_ENABLED is only its BOOT default. Never: sickness, heavy events,
# money, job/career, cast or place changes, relationship metrics.
CHAT_INFLUENCE_ENABLED=false
CHAT_INFLUENCE_MOOD=true              # chats may shift his mood (subtle, decaying)
CHAT_INFLUENCE_SLEEP=true             # a live chat may push his sleep 30 min at a time
CHAT_INFLUENCE_WORK=true              # chatting through a work hour adds work pressure
CHAT_INFLUENCE_INVITES=true           # invitations (spec 012 P2)
CHAT_INFLUENCE_ADVICE=true            # life-direction advice → Director tray (spec 012 P3)
CHAT_INFLUENCE_TELL_BACKOUT=true      # he sends one message in the chat when he backs out of a plan made there (spec 020)
CHAT_INFLUENCE_JEV_MAX_PER_DAY=80     # perception calls (life.chat.perceive) per day (0–200)
CHAT_INFLUENCE_PER_SENDER_HOUR=6      # perception calls per sender per hour (1–20)
CHAT_INFLUENCE_PER_CHAT_HOUR=20       # perception calls per chat per hour (1–60)
CHAT_INFLUENCE_CLERK_MAX_PER_DAY=20   # invitation extractions per day (0–60)
CHAT_INFLUENCE_INVITES_MAX_PER_DAY=4  # invitation decisions per day (0–10)
CHAT_INFLUENCE_INVITE_WAIT_MS=2000    # how long a reply may wait for an invitation (0–2000)
CHAT_INFLUENCE_MOOD_SCALE=1           # softens the fixed mood caps (0–1)
CHAT_INFLUENCE_WORK_MSGS_PER_HOUR=25  # his sent messages in a work hour before he falls behind (10–100)
CHAT_INFLUENCE_JEV_TIMEOUT_MS=1800    # perception call timeout (.env only, 500–5000)
CHAT_INFLUENCE_SLEEP_MAX_MINUTES=120  # most a night's sleep can be pushed (.env only, 0–120)
CHAT_INFLUENCE_ADVICE_DAYS=14         # advice tray expiry (.env only, 1–14)
CHAT_INFLUENCE_ADVICE_PER_CATEGORY=3  # pending advice per category (.env only, 1–3)

# Public site (specs/013) — a filtered snapshot of his simulated life pushed to
# Cloudflare R2 every few minutes for a static site (Pages). Outbound only: nothing on
# this machine is opened to the internet. Needs the "life" skill on. The master on/off
# is the "public-site" skill; PUBLIC_SITE_ENABLED is only its BOOT default. Never on the
# site: chat text, chat/group names, numbers, real names of people not opted in (person
# page), his home, the mind's notes, claims, costs, unpublished journal nights.
PUBLIC_SITE_ENABLED=false
PUBLIC_SITE_INTERVAL_MINUTES=5        # export cadence (.env only, 2–60)
PUBLIC_SITE_DAYS=14                   # past days of diary rows on the site (.env only, 1–30)
# R2 (S3 API) — a token scoped to ONE bucket, Object Read & Write. Never logged or shown.
R2_ENDPOINT=                          # https://<account id>.r2.cloudflarestorage.com
R2_BUCKET=                            # e.g. karyasthan-public (public read via r2.dev or a custom domain)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PUBLIC_JSON_URL=                      # the public URL of public.json (shown on the dashboard only)
# The votes Worker (site repo, worker/): the bot pulls tallies with a read token.
PUBLIC_VOTES_URL=                     # https://<worker host>
PUBLIC_VOTES_READ_TOKEN=              # ≥ 24 chars, the Worker's READ_TOKEN secret

# Dashboard (web UI on localhost — expose via SSH tunnel or Tailscale)
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=7070
DASHBOARD_USER=
DASHBOARD_PASS_HASH=            # bcrypt hash: node -e 'import("bcryptjs").then(b=>b.default.hash("yourpass",10).then(console.log))'
DASHBOARD_COOKIE_SECRET=        # random 32+ char string (defaults to PASS_HASH if empty)
DASHBOARD_ALLOW_CIDRS=127.0.0.1/32,::1/128   # loopback only; append 100.64.0.0/10 to allow Tailscale
DASHBOARD_READONLY=true         # true blocks every write method; set false to edit state (writes need the CSRF token and are audited)
